# server/.env.example — copy to server/.env (`npm run setup` does this and fills in fresh secrets).
# Every variable is explained in the README ("Environment variables").

# ============================================================================
#  THE ONE KEY YOU STILL NEED TO ADD
# ============================================================================
# Groq powers the AI summaries ("Tell me simply", "In short", visit-summary drafts).
# 1. Go to https://console.groq.com/keys -> Create API Key (free tier available; keys start with gsk_).
# 2. Paste it after the = sign below (no quotes, no spaces), save, restart `npm run dev`.
# Without it the app still works, using simple built-in sentences.
# Check it works: Caregiver dashboard -> Settings -> System status -> Test AI.
GROQ_API_KEY=
# Fast model. Names change: see https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Time limits (ms): who-is-this sentence / questions + "Tell me simply" / caregiver drafts
LLM_TIMEOUT_MS=3000
LLM_ASK_TIMEOUT_MS=8000
LLM_DRAFT_TIMEOUT_MS=15000
LLM_DAILY_CALL_LIMIT=500
LLM_PER_PATIENT_PER_MIN=6

# ============================================================================
#  Filled in by `npm run setup` (generated secrets — keep them; back them up)
# ============================================================================
NODE_ENV=development
PORT=4000
# localhost = this computer only. 0.0.0.0 = other devices on your Wi-Fi (then also set HTTPS below).
HOST=localhost
# HTTPS_KEY_FILE=./certs/key.pem
# HTTPS_CERT_FILE=./certs/cert.pem

# Local MongoDB (or an Atlas mongodb+srv:// URI)
MONGO_URI=mongodb://127.0.0.1:27017/dementia_assistant
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4000
TRUST_PROXY=0

# --- Sign-in ---
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
# Caregiver sessions (days)
REFRESH_TOKEN_TTL_DAYS=30
# Patient devices stay signed in this long; every use extends it (days)
PATIENT_SESSION_DAYS=180
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MIN=15
PAIRING_CODE_TTL_MIN=15
# Patient PIN: wrong tries before a short lock, and the lock length (minutes)
PIN_MAX_FAILURES=5
PIN_LOCKOUT_MIN=15
ALLOW_REGISTRATION=true

# --- Encryption at rest (AES-256-GCM). BACK IT UP: losing it = encrypted data unreadable.
ENCRYPTION_KEY=
UPLOAD_DIR=./uploads
CLIENT_DIST=../client/dist

# --- Face recognition service (started for you by `npm run dev`) ---
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SERVICE_SECRET=
MATCH_THRESHOLD=0.5
UNSURE_THRESHOLD=0.35
RECOG_FRAMES=5
RECOG_FRAMES_REQUIRED=3
RECOG_MARGIN=0.05
LIVENESS_MODE=motion
LIVENESS_MIN_YAW_RANGE=0.06
MAX_PHOTOS_PER_PERSON=5
VISIT_DEDUP_MIN=30

# --- Data retention job ---
RETENTION_JOB_INTERVAL_HOURS=6
